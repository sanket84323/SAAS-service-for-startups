# AI StartupOS Application Environment Variables

# Google Gemini API Key from Google AI Studio
# Get yours here: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=startupos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Spring Security JWT secret key (must be at least 256 bits/32 characters long)
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_chars
